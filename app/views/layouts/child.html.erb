<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for(:title) || t("app.title") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="view-transition" content="same-origin">
    <meta name="color-scheme" content="light dark">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%= render "appkit/shared/pwa_meta" %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body data-controller="theme" <%= tag.attributes(saved_theme_attributes) %>>
    <%= render "appkit/shared/skip_link" %>
    <header>
      <%= render layout: "appkit/shared/nav", locals: { home_path: child_dashboard_path } do %>
        <li><%= link_to t("child.dashboard.profile_link"), edit_user_profile_path(Current.user) %></li>
      <% end %>
    </header>
    <%= render "appkit/shared/flashes" %>
    <main id="main">
      <%= yield %>
    </main>
    <footer>
      <p><%= t("footer.copyright", year: Date.current.year, app_name: t("app.title")) %></p>
    </footer>
  </body>
</html>
