<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for(:title) || t("app.title") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="view-transition" content="same-origin">
    <meta name="color-scheme" content="light dark">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <% if Current.user.admin? %>
      <meta name="turbo-cache-control" content="no-cache">
    <% end %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%= render "appkit/shared/pwa_meta" %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body data-controller="theme" <%= tag.attributes(saved_theme_attributes) %>>
    <%= render "appkit/shared/skip_link" %>
    <header>
      <%= render layout: "appkit/shared/nav", locals: { home_path: parent_children_path } do %>
        <% if Current.user.admin? %>
          <li><%= link_to t("admin.nav.dashboard"), admin_root_path, "aria-current": (current_page?(admin_root_path) ? "page" : nil) %></li>
          <li><%= link_to t("admin.nav.users"), admin_users_path, "aria-current": (request.path.start_with?("/admin/users") ? "page" : nil) %></li>
        <% end %>
      <% end %>
    </header>
    <%= render "appkit/shared/flashes" %>
    <main id="main">
      <%= yield %>
    </main>
    <fieldset data-controller="push">
      <button type="button" data-action="push#subscribe"><%= t("parent.push.enable") %></button>
    </fieldset>
    <footer>
      <p><%= t("footer.copyright", year: Date.current.year, app_name: t("app.title")) %></p>
    </footer>
  </body>
</html>
