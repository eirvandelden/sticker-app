<%# locals: (form:, cancel_path:, submit_label: nil, delete_form_id: nil, delete_label: nil) %>
<footer>
  <% if delete_form_id %>
    <%= button_tag delete_label, type: "submit", form: delete_form_id, class: "button-danger" %>
  <% end %>
  <%= link_to t("common.cancel"), cancel_path, role: "button", class: "button-secondary" %>
  <%= form.submit submit_label || t("common.save") %>
</footer>
