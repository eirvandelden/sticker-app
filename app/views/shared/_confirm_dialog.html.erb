<dialog id="confirm-dialog" aria-labelledby="confirm-dialog-message">
  <p id="confirm-dialog-message"></p>
  <footer>
    <button type="button" id="confirm-dialog-cancel" autofocus><%= t(".cancel") %></button>
    <button type="button" id="confirm-dialog-accept" class="button-danger"><%= t(".accept") %></button>
  </footer>
</dialog>
