<div>
  <header>
    <h1><%= t(".title") %></h1>
    <nav>
      <%= link_to t(".new_user"), new_admin_user_path %>
    </nav>
  </header>

  <article>
    <table>
      <thead>
        <tr>
          <th><%= t(".name") %></th>
          <th><%= t(".email") %></th>
          <th><%= t(".role") %></th>
          <th><%= t(".created_at") %></th>
          <th><%= t(".actions") %></th>
        </tr>
      </thead>
      <tbody>
        <% @users.each do |user| %>
          <tr>
            <td><%= user.name %></td>
            <td><%= user.email %></td>
            <td><%= user.role %></td>
            <td><%= l(user.created_at, format: :long) %></td>
            <td>
              <%= link_to t(".view"), admin_user_path(user) %>
              <%= link_to t(".edit"), edit_admin_user_path(user) %>
              <% unless user == Current.user %>
                <div data-controller="dialog">
                  <button type="button" class="button-danger" data-action="dialog#open"><%= t(".delete_ellipsis") %></button>
                  <dialog data-dialog-target="dialog" aria-labelledby="<%= dom_id(user, :confirm_delete) %>">
                    <h2 id="<%= dom_id(user, :confirm_delete) %>"><%= t(".confirm_delete") %></h2>
                    <footer>
                      <form method="dialog">
                        <button><%= t(".cancel") %></button>
                      </form>
                      <%= button_to t(".delete"), admin_user_path(user), method: :delete %>
                    </footer>
                  </dialog>
                </div>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </article>
</div>
