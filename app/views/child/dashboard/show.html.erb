<%= render "shared/title_bar", title: t("child.dashboard.title") %>

<div data-controller="confetti"
     data-confetti-completion-flag-id-value="<%= dom_id(@child_profile, :completion_flag) %>"
     data-confetti-child-id-value="<%= @child_profile.id %>"
     data-confetti-completed-card-ids-value="<%= @completed_card_ids.to_json %>">
  <article>
    <%= turbo_stream_from @child_profile %>

    <span id="<%= dom_id(@child_profile, :completion_flag) %>"></span>

    <section id="<%= dom_id(@child_profile, :notifications) %>">
      <%= render partial: "child/dashboard/sticker_notification", collection: @recent_stickers, as: :sticker %>
    </section>

    <%= render "child/dashboard/card", child_profile: @child_profile, last_viewed: @last_viewed %>

    <%= render "shared/allowances", child_profile: @child_profile %>
  </article>
</div>
