<%= render layout: "shared/title_bar", locals: { title: t("parent.child_profile.edit.title") } do %>
  <%= link_to t("parent.child_profile.edit.back"), parent_children_path %>
<% end %>

<article>
  <% if @invalid_allowance && @invalid_allowance.kind.nil? %>
    <%= render "shared/form_errors", record: @invalid_allowance %>
  <% end %>

  <section>
    <h2><%= t("parent.child_profile.edit.headings.name") %></h2>
    <%= form_with model: @child.user, url: parent_child_path(@child), method: :patch do |form| %>
      <%= render "shared/form_errors", record: @child.user %>

      <fieldset>
        <label for="user_name"><%= t("parent.child_profile.edit.name_label") %></label>
        <%= form.text_field :name, required: true %>
      </fieldset>

      <%= render "shared/action_row", form: form, cancel_path: parent_children_path %>
    <% end %>
  </section>

  <section>
    <h2><%= t("parent.child_profile.edit.headings.avatar") %></h2>
    <%= form_with model: @child.user, url: parent_child_avatar_path(@child), method: :patch, multipart: true do |form| %>
      <%= render "shared/form_errors", record: @child.user %>

      <% if @child.user.avatar_displayable? %>
        <figure>
          <figcaption><%= t("parent.child_profile.edit.current_avatar") %></figcaption>
          <%= image_tag @child.user.avatar, size: "80x80", alt: @child.user.name %>
        </figure>
      <% end %>

      <fieldset>
        <label for="user_avatar"><%= t("parent.child_profile.edit.avatar_label") %></label>
        <%= form.file_field :avatar, accept: "image/*", required: true %>
      </fieldset>

      <%= render "shared/action_row", form: form, cancel_path: parent_children_path %>
    <% end %>
  </section>

  <section>
    <h2><%= t("parent.child_profile.edit.headings.goals") %></h2>
    <%= form_with model: @child, url: parent_child_child_profile_path(@child), method: :patch do |form| %>
      <%= render "shared/form_errors", record: @child %>

      <fieldset>
        <label for="child_profile_sticker_goal"><%= t("parent.child_profile.edit.sticker_goal_label") %></label>
        <%= form.number_field :sticker_goal, min: 1, required: true %>
      </fieldset>

      <fieldset>
        <label for="child_profile_goal"><%= t("parent.child_profile.edit.goal_label") %></label>
        <%= form.text_field :goal %>
      </fieldset>

      <fieldset>
        <label for="child_profile_birthdate"><%= t("parent.allowances.birthdate_label") %></label>
        <%= form.date_field :birthdate %>
      </fieldset>

      <%= render "shared/action_row", form: form, cancel_path: parent_children_path %>
    <% end %>
  </section>

  <% [ :zakgeld, :kleedgeld ].each do |kind| %>
    <% allowance = @invalid_allowance&.kind&.to_sym == kind ? @invalid_allowance : @child.allowances.find_by(kind: kind) %>
    <section>
      <h2><%= t("parent.child_profile.edit.headings.#{kind}") %></h2>

      <% if allowance&.persisted? %>
        <% nibud = NibudAdvice.suggested_amount_cents(birthdate: @child.birthdate, kind: kind, frequency: allowance.frequency.to_sym) %>
        <%= form_with model: allowance, url: parent_child_allowance_path(@child, allowance), method: :patch do |form| %>
          <%= render "shared/form_errors", record: allowance %>

          <fieldset>
            <label><%= t("parent.allowances.amount_label") %></label>
            <%= form.number_field :amount_cents, min: 1, required: true %>
            <% if nibud %>
              <small><%= t("parent.allowances.nibud_suggestion", amount: nibud) %></small>
            <% end %>
          </fieldset>

          <%= render "shared/action_row", form: form, cancel_path: parent_children_path,
                                          delete_form_id: dom_id(allowance, :delete),
                                          delete_label: t("parent.allowances.turn_off") %>
        <% end %>
        <%= render "shared/delete_form", record: allowance, url: parent_child_allowance_path(@child, allowance) %>
      <% else %>
        <% nibud_weekly  = NibudAdvice.suggested_amount_cents(birthdate: @child.birthdate, kind: kind, frequency: :weekly) %>
        <% nibud_monthly = NibudAdvice.suggested_amount_cents(birthdate: @child.birthdate, kind: kind, frequency: :monthly) %>
        <%= form_with model: (allowance || @child.allowances.build(kind: kind)),
                      url: parent_child_allowances_path(@child), method: :post do |form| %>
          <%= render "shared/form_errors", record: form.object %>

          <fieldset>
            <label><%= t("parent.allowances.frequency_label") %></label>
            <%= form.select :frequency,
                            [ [ t("parent.allowances.frequency_weekly"), "weekly" ],
                              [ t("parent.allowances.frequency_monthly"), "monthly" ] ] %>
          </fieldset>
          <fieldset>
            <label><%= t("parent.allowances.amount_label") %></label>
            <%= form.number_field :amount_cents, min: 1, required: true,
                                  placeholder: nibud_weekly || nibud_monthly %>
            <% if nibud_weekly %>
              <small><%= t("parent.allowances.nibud_suggestion", amount: nibud_weekly) %> (<%= t("parent.allowances.frequency_weekly").downcase %>)</small>
            <% end %>
            <% if nibud_monthly %>
              <small><%= t("parent.allowances.nibud_suggestion", amount: nibud_monthly) %> (<%= t("parent.allowances.frequency_monthly").downcase %>)</small>
            <% end %>
          </fieldset>
          <fieldset>
            <label><%= t("parent.allowances.due_day_label") %></label>
            <%= form.number_field :due_day, min: 0, max: 31, required: true %>
          </fieldset>
          <%= form.hidden_field :kind %>

          <%= render "shared/action_row", form: form, cancel_path: parent_children_path %>
        <% end %>
      <% end %>
    </section>
  <% end %>
</article>
