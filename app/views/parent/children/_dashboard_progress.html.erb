<div id="<%= dom_id(child, :dashboard_progress) %>">
  <%= render "parent/children/sticker_progress", card: child.display_sticker_card %>

  <% ready = child.rewardable_sticker_cards_count %>
  <% if ready.positive? %>
    <p id="<%= dom_id(child, :reward_badge) %>"><%= t("parent.dashboard.rewardable_cards", count: ready) %></p>
    <%= button_to t("parent.actions.mark_rewarded"), parent_child_reward_path(child),
                  method: :post,
                  class: "button-success" %>
  <% end %>
</div>
