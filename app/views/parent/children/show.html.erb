<%= render layout: "shared/title_bar",
           locals: { title: safe_join([ (image_tag(@child.user.avatar, size: "40x40", alt: "") if @child.user.avatar.attached?),
                                        @child.user.name ].compact, " "),
                     back: record_back_link(parent_children_path) } do %>
  <%= link_to t("parent.actions.view_history"), parent_child_history_path(@child) %>
<% end %>

<%= turbo_stream_from @child %>

<%= render "parent/children/child_card", child: @child %>
