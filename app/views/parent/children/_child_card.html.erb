<section id="<%= dom_id(child, :parent_card) %>">
  <% card = child.display_sticker_card %>
  <% rewardable_card = child.rewardable_sticker_card %>
  <% total_stickers = card.positive_count %>
  <% needed = card.required_stickers %>

  <progress value="<%= total_stickers %>" max="<%= needed %>"
            aria-label="<%= t("parent.dashboard.progress", current: total_stickers, total: needed) %>"></progress>
  <p><%= t("parent.dashboard.progress", current: total_stickers, total: needed) %></p>

  <% if card.goal.present? %>
    <p><%= t("parent.dashboard.goal", goal: card.goal) %></p>
  <% end %>

  <%= form_with url: parent_child_card_goal_path(child), method: :patch do |form| %>
    <label for="<%= dom_id(child, :goal_field) %>"><%= t("parent.child_profile.edit.goal_label") %></label>
    <%= form.text_field :goal, name: "sticker_card[goal]", value: card.goal, id: dom_id(child, :goal_field) %>
    <%= form.submit t("parent.child_profile.edit.save") %>
  <% end %>

  <% if rewardable_card %>
    <p><%= t("parent.dashboard.card_completed") %></p>
    <%= button_to t("parent.actions.mark_rewarded"), parent_child_reward_path(child),
                  method: :post, class: "button-success" %>
  <% end %>

  <% [ child.zakgeld, child.kleedgeld ].compact.each do |allowance| %>
    <% owed_count = allowance.owed_periods.count %>
    <p>
      <%= t("child.dashboard.allowances.#{allowance.kind}") %>:
      <% if owed_count > 0 %>
        <%= t("child.dashboard.allowances.owed", count: owed_count) %>
        <%= button_to t("parent.actions.mark_allowance_given"),
                      parent_child_allowance_payments_path(child),
                      params: { kind: allowance.kind },
                      method: :post, class: "button-success" %>
      <% else %>
        <%= t("child.dashboard.allowances.none_owed") %>
      <% end %>
    </p>
  <% end %>
</section>
