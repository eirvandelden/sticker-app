class ChildProfile < ApplicationRecord
  extend _ModelQueries[ChildProfile]
  include GeneratedAttributeMethods
  include GeneratedAssociationMethods

  module GeneratedAttributeMethods
    def birthdate: () -> Date?
    def goal: () -> String?
    def sticker_goal: () -> Integer
    def saved_change_to_sticker_goal?: () -> bool
    def saved_change_to_goal?: () -> bool
  end

  module GeneratedAssociationMethods
    def user: () -> User
    def sticker_cards: () -> untyped
    def allowances: () -> untyped
  end

  def broadcast_replace_to: (*untyped, **untyped) -> void
end
