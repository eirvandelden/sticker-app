class Sticker < ApplicationRecord
  extend _ModelQueries[Sticker]
  include GeneratedAttributeMethods
  include GeneratedAssociationMethods

  module GeneratedAttributeMethods
    def emoji: () -> String?
    def emoji=: (String?) -> String?
    def positive?: () -> bool
    def negative?: () -> bool
  end

  module GeneratedAssociationMethods
    def sticker_card: () -> StickerCard
    def sticker_card=: (StickerCard?) -> StickerCard?
    def giver: () -> User?
  end

  def broadcast_append_to: (*untyped, **untyped) -> void
end
