class User < ApplicationRecord
  extend _ModelQueries[User]
  include GeneratedAttributeMethods
  include GeneratedAssociationMethods

  module GeneratedAttributeMethods
    def locale: () -> String
    def role=: (String) -> String
    def child?: () -> bool
    def parent?: () -> bool
    def admin?: () -> bool
  end

  module GeneratedAssociationMethods
    def child_profile: () -> ChildProfile?
    def create_child_profile!: () -> ChildProfile
    def avatar: () -> untyped
    def attachment_changes: () -> Hash[String, untyped]
  end

  def self.active: () -> untyped
  def self.admin: () -> untyped
  def self.roles: () -> Hash[String, Integer]
end
